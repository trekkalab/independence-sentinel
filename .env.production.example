# Copy this to .env on the server and fill in real values

# A random 64+ character secret for Payload auth tokens
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Postgres connection string (if Postgres is on the same server)
DATABASE_URI=postgres://sentinel_user:CHANGE_ME@localhost:5432/independence_sentinel

# Public URL
NEXT_PUBLIC_SITE_URL=https://independencesentinel.com

# Node environment
NODE_ENV=production
PORT=3000
